{
    "name": "uams-web/uamswp-acf-maskfield",
    "description": "UAMSWP Advanced Custom Fields: Mask Field. Development dependencies only; nothing here is installed into production.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/acf-pro-stubs": "^6.8",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "pest",
        "stan": "phpstan analyse --memory-limit=1G",
        "refactor": "rector process",
        "refactor:sweep": "rector process --config=rector-sweep.php",
        "test:refactor": "rector process --dry-run",
        "test:refactor:sweep": "rector process --dry-run --config=rector-sweep.php",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database."
    }
}

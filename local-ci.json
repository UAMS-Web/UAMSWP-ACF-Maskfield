{
  "_spell": "cspell:ignore analyse .",
  "base": "main",
  "php": "8.4",
  "chain": false,
  "guard": {
    "deny": [
      "wp-config\\.php$",
      "\\.sql(\\.gz)?$",
      "\\.(csv|tsv|xlsx?)$",
      "\\.env(\\.|$)",
      "\\.pem$",
      "\\.key$"
    ]
  },
  "jobs": [
    {
      "name": "lint",
      "run": "php -l",
      "each": ["**/*.php", "!vendor/**"],
      "always": true
    },
    {
      "name": "lint-floor",
      "run": "php -l",
      "php": "8.2",
      "each": ["**/*.php", "!vendor/**", "!tests/**"],
      "always": true
    },
    {
      "name": "synced-files",
      "run": "node .claude/skills/synced-files/scripts/check-synced-files.mjs",
      "always": true,
      "requires": ["bin:node"]
    },
    {
      "name": "download-archive",
      "run": "node .claude/skills/download-archive-check/check-download-archive.mjs",
      "always": true,
      "requires": ["bin:node", "bin:git"]
    },
    {
      "name": "pint",
      "run": "vendor/bin/pint --test",
      "paths": ["**/*.php", "!vendor/**", "pint.json", "composer.lock"]
    },
    {
      "name": "rector",
      "run": "vendor/bin/rector process --dry-run",
      "paths": ["**/*.php", "!vendor/**", "rector.php", "rector-sweep.php", "composer.lock"]
    },
    {
      "name": "phpstan",
      "run": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
      "paths": ["**/*.php", "!vendor/**", "phpstan.neon.dist", "composer.lock"]
    },
    {
      "name": "pest",
      "run": "vendor/bin/pest",
      "paths": ["**/*.php", "!vendor/**", "phpunit.xml*", "composer.lock"]
    }
  ]
}
